# Frontend (.env) – nur bauzeitrelevant (VITE_*).
# Leer lassen -> Default "/audio-cutter/api" (relativ, via Nginx-Proxy).
VITE_API_BASE_URL=
# Ziel für „An Audiokonverter senden“ (muss dieselbe Origin haben, Default "/audiokonverter/").
VITE_AUDIOKONVERTER_URL=
# Ziel für „An Normalisierer senden“ (dieselbe Origin, Default "/audionormalisierer/app").
VITE_AUDIONORMALISIERER_URL=
# Ziel für „An Equalizer 19 senden“ (dieselbe Origin, Default "/equaliser19/app").
VITE_EQUALISER19_URL=
# Ziel für „An Playlist-Generator senden“ (dieselbe Origin, Default "/playlist_generator/app").
VITE_PLAYLIST_GENERATOR_URL=
